FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force

COPY server ./server
COPY hub/src ./hub/src
COPY extension/protocol.js extension/groups.js ./extension/

ENV NODE_ENV=production \
    BROWSER_RELAY_HUB_HOST=0.0.0.0 \
    BROWSER_RELAY_HUB_PORT=18796

EXPOSE 18796

USER node

CMD ["node", "server/hub-server.js"]
